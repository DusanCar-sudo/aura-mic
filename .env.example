# Aura Mic — ElevenLabs API key
# Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Default TTS voice (ElevenLabs voice ID or friendly name)
ELEVENLABS_VOICE=rachel

# STT model: scribe_v1 (default) or scribe_v1_experimental
ELEVENLABS_STT_MODEL=scribe_v1

# Recording sample rate
SAMPLE_RATE=16000

# Silence threshold in ms for auto-stop (0 = manual Ctrl+C only)
SILENCE_MS=2200

# Max recording duration in ms (default 180000 = 3 minutes)
MAX_DURATION_MS=180000

# DeepInfra — LLM chat backend. Get from https://deepinfra.com/dash
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepinfra/Qwen/Qwen3-Max
